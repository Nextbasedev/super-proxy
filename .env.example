# Super Proxy — example environment (no secrets)
NODE_ENV=development
PORT=8080
DATABASE_PATH=./data/super-proxy.sqlite
ADMIN_EMAIL=admin@localhost

# Optional upstream overrides
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
OPENAI_PLATFORM_UPSTREAM_URL=https://api.openai.com/v1
GROQ_UPSTREAM_URL=https://api.groq.com/openai/v1
OPENROUTER_UPSTREAM_URL=https://openrouter.ai/api/v1
XAI_UPSTREAM_URL=https://api.x.ai/v1

# Provider credentials are stored via admin/API token flows or your SecretStore —
# do not commit real keys.
